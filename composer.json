{
  "name": "silviooosilva/cacheer-php",
  "description": "CacheerPHP is a minimalist package for caching in PHP, offering a simple interface for storing and retrieving cached data using multiple backends.",
  "keywords": [
    "cache",
    "optimizer",
    "performance",
    "PHP",
    "caching",
    "cache-manager",
    "Silviooosilva",
    "speed",
    "optimization",
    "file-cache",
    "database",
    "database-cache",
    "mysql",
    "sqlite",
    "pgsql",
    "redis",
    "predis",
    "nosql",
    "psr-16",
    "psr-3"
  ],
  "homepage": "https://github.com/silviooosilva",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Silviooosilva\\CacheerPhp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@test:unit",
    "test:unit": "@php vendor/bin/pest --testsuite=Unit --colors=always",
    "test:parallel": "@php vendor/bin/pest --testsuite=Unit --parallel --colors=always",
    "test:integration": "@php vendor/bin/pest --testsuite=Integration --colors=always",
    "test:integration:redis": "@php vendor/bin/pest tests/Integration/Redis --colors=always",
    "test:integration:database": "@php vendor/bin/pest tests/Integration/Database --colors=always",
    "test:all": "@php vendor/bin/pest --colors=always",
    "benchmark:baseline": "@php benchmarks/v5-baseline.php",
    "fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
  },
  "authors": [
    {
      "name": "Sílvio Silva",
      "email": "gasparsilvio7@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6",
    "predis/predis": "^2.3",
    "psr/simple-cache": "^3.0",
    "psr/log": "^3.0",
    "ext-pdo": "*",
    "ext-openssl": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "pestphp/pest": "^3.8 || ^4.7"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
