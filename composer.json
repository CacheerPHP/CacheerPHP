{
  "name": "silviooosilva/cacheer-php",
  "description": "CacheerPHP is a minimalist package for caching in PHP, offering a simple interface for storing and retrieving cached data using multiple backends.",
  "keywords": [
    "cache",
    "optimizer",
    "performance",
    "PHP",
    "caching",
    "cache-manager",
    "Silviooosilva",
    "speed",
    "optimization",
    "file-cache",
    "database",
    "database-cache",
    "mysql",
    "sqlite",
    "pgsql",
    "redis",
    "predis",
    "nosql",
    "psr-16",
    "psr-3"
  ],
  "homepage": "https://github.com/silviooosilva",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/silviooosilva/CacheerPHP/issues",
    "source": "https://github.com/silviooosilva/CacheerPHP",
    "docs": "https://cacheerphp.com/docs/en/getting-started/",
    "security": "https://github.com/silviooosilva/CacheerPHP/security/policy"
  },
  "bin": [
    "bin/cacheer"
  ],
  "autoload": {
    "psr-4": {
      "Silviooosilva\\CacheerPhp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@test:unit",
    "test:unit": "@php vendor/bin/pest --testsuite=Unit --colors=always",
    "test:contract": "@php vendor/bin/pest --testsuite=Contract --colors=always",
    "test:benchmark": "@php vendor/bin/pest --testsuite=Benchmark --colors=always",
    "test:kernel": "@php vendor/bin/pest --testsuite=Kernel --colors=always",
    "test:storage": "@php vendor/bin/pest --testsuite=Storage --colors=always",
    "test:conformance": [
      "@test:contract",
      "@test:integration"
    ],
    "test:parallel": "@php vendor/bin/pest --testsuite=Unit --parallel --colors=always",
    "test:integration": "@php vendor/bin/pest --testsuite=Integration --colors=always",
    "test:integration:redis": "@php vendor/bin/pest tests/Integration/Redis --colors=always",
    "test:integration:database": "@php vendor/bin/pest tests/Integration/Database --colors=always",
    "test:all": "@php vendor/bin/pest --colors=always",
    "benchmark:baseline": "@php benchmarks/v5-baseline.php",
    "benchmark:compare": "@php benchmarks/compare.php",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
    "lint": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --dry-run --diff",
    "fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
  },
  "authors": [
    {
      "name": "Sílvio Silva",
      "email": "gasparsilvio7@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "psr/simple-cache": "^3.0",
    "psr/cache": "^3.0",
    "psr/log": "^3.0",
    "psr/event-dispatcher": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "pestphp/pest": "^5.0",
    "phpstan/phpstan": "^2.1",
    "predis/predis": "^2.3",
    "ext-pdo": "*",
    "ext-openssl": "*",
    "ext-zlib": "*"
  },
  "suggest": {
    "predis/predis": "Use the Redis cache driver over TCP (or install the phpredis extension).",
    "ext-redis": "Use the Redis cache driver via the native phpredis extension.",
    "ext-pdo": "Use the database cache driver (SQLite, MySQL, MariaDB, or PostgreSQL).",
    "ext-openssl": "Enable authenticated AES-256-GCM encryption of cached values.",
    "ext-zlib": "Enable gzip compression of cached values."
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-6.x": "6.0.x-dev"
    }
  }
}
